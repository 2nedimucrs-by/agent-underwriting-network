{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanHireRequest",
  "type": "object",
  "required": ["agent_id", "task_type"],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^github:[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
    },
    "task_type": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "limits": {
      "type": "object",
      "properties": {
        "write_access": {"type": "boolean"},
        "max_spend_usd": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "maxProperties": 3,
  "additionalProperties": false
}
